{
  "multipart": [
    { "when": { "north": "true" }, "apply": { "model": "farmers_future_delight:glow_lichen" } },
    { "when": { "south": "true" }, "apply": { "model": "farmers_future_delight:glow_lichen", "y": 180, "uvlock": true } },
    { "when": { "up": "true" }, "apply": { "model": "farmers_future_delight:glow_lichen", "x": 270, "uvlock": true } },
    { "when": { "down": "true" }, "apply": { "model": "farmers_future_delight:glow_lichen", "x": 90, "uvlock": true } },
    { "apply": { "model": "farmers_future_delight:glow_lichen", "y": 270, "uvlock": true } }
  ]
}
